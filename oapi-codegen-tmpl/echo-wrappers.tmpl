// ServerInterfaceWrapper binds parameters and dispatches to whichever of the
// registered handlers implements an operation.
type ServerInterfaceWrapper struct {
	Handlers []any
	Validate *validation.Vld // validates request bodies of typed handlers

	used map[int]struct{} // indexes of Handlers that implement at least one operation
}

// committed reports whether a typed handler already wrote the response itself
// (the generic escape hatch: write to c, then return the zero value and no error).
func committed(c *echo.Context) bool {
	rw, err := echo.UnwrapResponse(c.Response())

	return err == nil && rw.Committed
}

func find[T any](w *ServerInterfaceWrapper) (T, bool) {
	for i, h := range w.Handlers {
		if t, ok := h.(T); ok {
			if w.used == nil {
				w.used = map[int]struct{}{}
			}
			w.used[i] = struct{}{}

			return t, true
		}
	}
	var zero T
	return zero, false
}

